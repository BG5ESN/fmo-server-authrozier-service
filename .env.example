# Copy this file to .env and replace the placeholder values before deployment.
SAS_SERVER_UID=12345
SAS_SERVER_CALLSIGN=BG5ESN
# 设备侧访问 MQTT 的公开域名/IP（与 APRS STATION 广播的 url 字段一致），不要填 Compose 内部服务名 emqx
SAS_MQTT_HOST=EXAMPLE.COM
SAS_MQTT_PORT=1883
SAS_CERT_FINGERPRINT=YOUR_CERT_FINGERPRINT
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_THIS_DASHBOARD_PASSWORD

# Host-published ports (optional to change)
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
FAS_PORT=9527
